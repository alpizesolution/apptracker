# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.
# Leave the Supabase values empty to run without sign-in (board saved in the browser).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The GitHub App's URL name (github.com/apps/<slug>), used for the "choose repos" link.
NEXT_PUBLIC_GITHUB_APP_SLUG=

# Random string of 32+ characters that encrypts the GitHub token cookie.
# Generate one with: openssl rand -base64 48
TOKEN_SECRET=
