# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.
# Leave the Firebase values empty to run without sign-in (board saved in the browser).

# Firebase console → Project settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The GitHub App's URL name (github.com/apps/<slug>), used for the "choose repos" link.
NEXT_PUBLIC_GITHUB_APP_SLUG=

# Random string of 32+ characters that encrypts the session cookie holding the GitHub token.
# Generate one with: openssl rand -base64 48
TOKEN_SECRET=
